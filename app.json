{
  "expo": {
    "name": "leaf-weighing-app",
    "slug": "leaf-weighing-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "leafweighingapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ceybaseit.leafweighingapp",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.ceybaseit.leafweighingapp",
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "cover",
        "backgroundColor": "#ffffff",
        "mdpi": "./assets/images/splash-icon.png",
        "hdpi": "./assets/images/splash-icon.png",
        "xhdpi": "./assets/images/splash-icon.png",
        "xxhdpi": "./assets/images/splash-icon.png",
        "xxxhdpi": "./assets/images/splash-icon.png"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff",
          "enableFullScreenImage_legacy": true
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}